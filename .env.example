# Supabase Postgres credentials.
# Copy this file to `.env` and fill in real values. The real .env is gitignored.

# The DB password you set when creating the Supabase project.
# Special characters are OK — db.py URL-encodes this before use.
supabasePW=

# Your Supabase project reference. Find it in Project Settings → General → Project ID,
# or in the project URL (https://supabase.com/dashboard/project/<this>).
SUPABASE_PROJECT_REF=

# The Transaction pooler hostname. Find it in your project: top-bar "Connect" button
# → Transaction pooler tab → host field. Looks like:
#   aws-0-eu-west-1.pooler.supabase.com
# (The 'aws-0-' prefix and region vary by project — copy exactly what Supabase shows.)
SUPABASE_POOLER_HOST=

# --- Gmail alert credentials (alerts.py) ---------------------------------
# Used to email yourself when the scraper finds genuinely new jobs (rows
# that didn't exist in Supabase before this run). Missing values = alerts
# are silently skipped; the rest of the scrape still works.

# The Gmail address that will SEND the alert (also the default recipient).
GMAIL_ADDRESS=

# A 16-character Google App Password (NOT your normal Gmail password).
# Create at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on the Google account.
# Paste with or without the spaces Google shows — alerts.py strips them.
GMAIL_APP_PASSWORD=

# Optional. Where to send the alert. Defaults to GMAIL_ADDRESS if unset.
ALERT_TO=
